<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Entitlements for the Elisa app under the macOS hardened runtime.

	  The bundled Claude Agent SDK CLI is a Bun-based native binary. To run under
	  the hardened runtime it requires JIT, unsigned-executable-memory, a relaxed
	  library-validation policy (so the re-signed nested binary can load), and
	  dyld environment-variable passthrough. AUTH note: the CLI subprocess is
	  forced to use the configured ANTHROPIC_API_KEY (see agentRunner.ts), so
	  dyld env passthrough does not enable a host ~/.claude login fallback.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
</dict>
</plist>
